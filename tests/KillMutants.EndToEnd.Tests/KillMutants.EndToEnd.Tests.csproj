<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/KillMutants.Core/KillMutants.Core.csproj" />
    <!--
      The exit codes are a public contract, so they are tested by running the real command-line tool
      rather than the policy behind it. Referenced only to have it built first; the tests launch it
      as a process.
    -->
    <ProjectReference Include="../../src/KillMutants.Cli/KillMutants.Cli.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
