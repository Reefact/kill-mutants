<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The point of this fixture: a test project built for two frameworks, which a run cannot choose
      between on its own. The target-framework option says which one it runs on (DEC0021).
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sample.Library/Sample.Library.csproj" />
  </ItemGroup>
</Project>
