<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn. Mutation generation, compilation and emit. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Slugger. Names the directories a run works in, from the kill-mutants theme embedded in
         KillMutants.Platform - see Scratch.CreateDirectory for why a name rather than a GUID.
         A prerelease, and it stays one for a while: Slugger cannot ship stable while its own
         FirstClassErrors is a prerelease (NU5104). That rule does not reach this tool: a tool
         package carries Slugger inside it and declares no dependency, so a stable KillMutants
         packs over a prerelease Slugger without the warning - measured with pack.sh at 1.0.0.
         It would reach a library published on the lib train, which declares its dependencies. -->
    <PackageVersion Include="Slugger" Version="1.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Release. Embeds the SPDX inventory in every package a release train ships; referenced from
         Directory.Build.targets for each project that declares a <ReleaseTrain>, and pinned here
         because central package management refuses a PackageReference with no PackageVersion
         (NU1010) - the fallback pin in Directory.Build.targets applies only without it. -->
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests. "xUnit 4" ships as the xunit.v3 package family at version 4.0.0;
         xunit.v3.mtp-v2 is the Microsoft Testing Platform 2 flavour. -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <!-- Coverage for the SonarQube Cloud analysis; see tests/TestCoverage.props. -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <!-- Property-based tests: generators and shrinking, called from an ordinary [Fact], so nothing
         ties it to the xUnit version above. No dependencies of its own. Each run draws a fresh
         seed on purpose, so every CI run tries cases no earlier one did; that does not make the
         gate flaky, because a failure is a counterexample rather than a timing, and its message
         names the seed that replays it (CsCheck_Seed=...). -->
    <PackageVersion Include="CsCheck" Version="5.0.0" />
  </ItemGroup>

</Project>
